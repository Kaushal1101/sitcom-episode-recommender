After implementing, verify with these commands (from repo root with `PYTHONPATH=.` or after `pip install -e .`):

```bash
# Full season scrape (Season 2)
python -m backend.pipeline --season the_office 2

# Spot-check specific episodes
python -m backend.pipeline --season the_office 2 --json | python -m json.tool

# Confirm output files exist
ls data/raw/the_office_s02_e01/
ls data/raw/the_office_s02_e22/

# Confirm extracted_data.json shape on two episodes
python -c "import json; d=json.load(open('data/raw/the_office_s02_e04/extracted_data.json')); print(list(d.keys())); print(list(d['narrative'].keys()))"
# Expected keys: ['episode_id', 'metadata', 'narrative']
# Expected narrative keys: ['cold_open', 'synopsis', 'cast']

# Confirm no legacy fields
python -c "import json; d=json.load(open('data/raw/the_office_s02_e04/extracted_data.json')); assert 'social' not in d; assert 'plot' not in d['narrative']; print('clean')"
```

